---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  /** Header sits over the first section (homepage video) */
  overlayHeader?: boolean;
}

const {
  title,
  overlayHeader = false,
  description = 'זמורוד חסן הנדסת מבנים: תכנון קונסטרוקציה, בקרת תכן, בקרת יציבות ומיגון.',
} = Astro.props;
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="icon" href={url('/favicon.ico')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+Hebrew:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <Header overlay={overlayHeader} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
