---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getImage } from 'astro:assets';
import posterSrc from '../assets/about-video-poster.jpg';
import award from '../assets/award-2020.jpg';
import { Image } from 'astro:assets';
import HeadStats from '../components/HeadStats.astro';
import { podcast, video } from '../lib/press';
import { url } from '../lib/url';

const poster = await getImage({ src: posterSrc, width: 1280, format: 'webp', quality: 70 });
---

<BaseLayout
  title="מן העיתונות | זמורוד חסן הנדסת מבנים"
  description="פודקאסטים, ראיונות ופרסים: זמורוד חסן, הנדסת מבנים."
>
  <!-- Page head: light drawing grid, like the projects page -->
  <section class="ph">
    <div class="container ph-grid">
      <div class="stack gap-20 ph-copy">
        <span class="eyebrow-mono">PRESS</span>
        <h1>מן העיתונות</h1>
        <p class="lead">תכירו אותנו יותר: הכתבות, הראיונות והפודקאסטים שבהם השתתפנו.</p>
      </div>
      <HeadStats />
    </div>
  </section>

  <!-- Podcast -->
  <section class="section podcast">
    <div class="container stack podcast-inner">
      <div class="stack gap-12">
        <span class="eyebrow">פודקאסט</span>
        <h2 class="h2">{podcast.title}</h2>
        <p class="meta">{podcast.show}<span aria-hidden="true">·</span>{podcast.date}</p>
      </div>
      <div class="stack gap-16 body">
        {podcast.body.map((para) => <p>{para}</p>)}
      </div>
      <iframe
        class="player"
        src={podcast.embed}
        title={`${podcast.title}, ${podcast.show}`}
        loading="lazy"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
      ></iframe>
      <div class="credits">
        {podcast.credits.map((line) => <p>{line}</p>)}
      </div>
    </div>
  </section>

  <!-- Video -->
  <section class="section video-section">
    <div class="container stack gap-40">
      <div class="stack gap-12">
        <span class="eyebrow">וידאו · {video.date}</span>
        <h2 class="h2">{video.title}</h2>
        <p class="lead">{video.subtitle}</p>
      </div>
      <div class="video-grid">
        <figure class="award">
          <Image
            src={award}
            alt="40 הצעירים המבטיחים בנדל&quot;ן ובהתחדשות עירונית 2020: זמורוד חסן"
            widths={[480, 720, 1080]}
            sizes="(max-width: 900px) 90vw, 520px"
          />
        </figure>
        <div class="video-frame">
          <video src={url(video.file)} poster={poster.src} controls preload="none" playsinline></video>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .gap-12 { gap: 12px; }
  .gap-16 { gap: 16px; }
  .gap-20 { gap: 20px; }
  .gap-24 { gap: 24px; }
  .gap-40 { gap: 40px; }

  .ph { position: relative; padding: 72px var(--gutter) 80px; background: var(--paper); overflow: hidden; }
  .ph::before { content: ''; position: absolute; inset: 0; pointer-events: none;
    background-image: linear-gradient(rgba(15,27,38,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(15,27,38,.05) 1px, transparent 1px);
    background-size: 24px 24px; -webkit-mask-image: linear-gradient(to bottom, #000 40%, transparent); mask-image: linear-gradient(to bottom, #000 40%, transparent); }
  .ph-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 440px); gap: 48px 64px; align-items: center; }
  .ph h1 { font-size: clamp(44px, 5.2vw, 76px); font-weight: 600; line-height: 1.08; }
  .ph .eyebrow-mono { color: var(--bronze); }
  .ph .lead { max-width: 640px; color: #2B3742; }
  @keyframes rise { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: none; } }
  .ph-copy > * { animation: rise .9s cubic-bezier(.2,.7,.2,1) both; }
  .ph-copy > :nth-child(2) { animation-delay: .15s; }
  .ph-copy > :nth-child(3) { animation-delay: .3s; }
  @media (prefers-reduced-motion: reduce) { .ph-copy > * { animation: none; } }
  @media (max-width: 900px) {
    .ph { padding: 56px var(--gutter) 40px; }
    .ph-grid { grid-template-columns: 1fr; gap: 36px; }
  }

  .podcast { background: var(--surface); }
  .podcast-inner { gap: 32px; }
  .meta { display: flex; flex-wrap: wrap; gap: 0 10px; font-size: 18px; color: var(--muted); }
  .meta span { color: var(--line-strong); }
  .body p { max-width: 1100px; font-size: 18px; line-height: 1.85; color: var(--muted); }
  .player { display: block; width: 100%; height: 352px; border: 0; }
  .credits { display: flex; flex-direction: column; gap: 4px; padding-top: 20px; border-top: 1px solid var(--line); }
  .credits p { font-size: 15px; color: var(--muted); }

  .video-section { background: var(--band); }
  .video-grid {
    display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 32px; align-items: center;
  }
  .award { margin: 0; border: 1px solid var(--line); }
  .award img { display: block; width: 100%; height: auto; }
  .video-frame { background: var(--night); border: 1px solid var(--line); }
  .video-frame video { display: block; width: 100%; height: auto; }

  @media (max-width: 900px) {
    .video-grid { grid-template-columns: 1fr; }
  }
</style>
