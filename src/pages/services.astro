---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import ServiceRows from '../components/ServiceRows.astro';
import Contact from '../components/Contact.astro';
import { site } from '../lib/site';
---

<Layout
  title={`שירותי החברה | ${site.legal}`}
  description="תכנון קונסטרוקציה, בקרת תכן מבנים וניהול ופיקוח — שירותי זמורוד חסן הנדסת מבנים."
>
  <PageHead
    kicker="מה אנחנו עושים"
    title="שירותי "
    accent="החברה"
    lead="שלושה תחומי ליבה — מהתכנון הקונסטרוקטיבי הראשוני, דרך בקרת תכן להוזלת עלויות, ועד ניהול ופיקוח צמוד באתר."
  />

  <ServiceRows />
  <Contact />
</Layout>
