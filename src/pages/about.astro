---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import About from '../components/About.astro';
import Recognition from '../components/Recognition.astro';
import Stats from '../components/Stats.astro';
import Contact from '../components/Contact.astro';
import { site } from '../lib/site';
---

<Layout
  title={`אודות | ${site.legal}`}
  description="זמורוד חסן — בוגרת הטכניון בהצטיינות, מבקרת תכן מוסמכת RICS, וזוכת פרסי הנדסה ונדל״ן."
>
  <PageHead
    kicker="הכירו את המשרד"
    title="אודות"
    lead="חברה לתכנון קונסטרוקציה וייעוץ הנדסי, הפועלת מזה 17 שנה ממשרדיה בגוליס."
  />

  <About headless />
  <Recognition />
  <Stats />
  <Contact />
</Layout>
