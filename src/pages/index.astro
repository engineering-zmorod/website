---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
import { contact } from '../lib/nav';
import { Image } from 'astro:assets';
import CraneHero from '../components/CraneHero.astro';
import visionBg from '../assets/vision-bg.jpg';
import portrait from '../assets/founder-cutout.png';
import { podcast } from '../lib/press';

const stats = [
  { value: 400, prefix: '', suffix: '+', label: 'פרויקטים' },
  { value: 300, prefix: '', suffix: '+', label: 'לקוחות' },
  { value: 17, prefix: '', suffix: ' שנים', label: 'ניסיון' },
  { value: 30, prefix: 'עד ', suffix: '', label: 'קומות, גובה המגדלים שאנחנו מתכננים' },
];

const activities = [
  { title: 'תכנון קונסטרוקטיבי', text: 'תכנון מגדלי מגורים ומשרדים, מבני ציבור, תעשייה ומסחר, מבני בוטיק ופרויקטים הנדסיים מורכבים.' },
  { title: 'בקרת תכן מבנים', text: 'בדיקה ובקרה של תכנונים קונסטרוקטיביים, בחינת חלופות תכנון ושיפור היעילות והכדאיות הכלכלית של הפרויקט.' },
  { title: 'בקרת יציבות ומיגון', text: 'בקרת יציבות מבנים והתאמתם לדרישות התקינה והמיגון, לרבות במסגרת הליכי רישוי ובקרת תוכניות ביצוע.' },
  { title: 'ליווי הנדסי וחוות דעת מקצועיות', text: 'ליווי פרויקטים ומתן חוות דעת מקצועיות לצורך בחינת פתרונות הנדסיים ושיפור תהליכי התכנון והביצוע.' },
  { title: 'ייעוץ הנדסי והתייעלות כלכלית', text: 'גיבוש פתרונות הנדסיים יעילים ואופטימליים, תוך בחינת היבטים הנדסיים וכלכליים.' },
];

const milestones = [
  { year: '2008', title: 'הטכניון', text: 'הפקולטה להנדסה אזרחית וסביבתית. סיום בהצטיינות, התמחות בתכנון מבנים עמידים ברעידות אדמה.' },
  { year: '2018', title: 'RICS London', text: 'בקרית תכן מבנים מורשית, בוגרת RICS.' },
  { year: '2019', title: 'מהנדסת צעירה מצטיינת בתכנון', text: 'מטעם איגוד המהנדסים והתשתיות בישראל.' },
  { year: '2020', title: '40 הצעירים המבטיחים', text: 'נבחרה לרשימה בתחום הנדל"ן וההתחדשות העירונית.' },
  { year: '2022', title: 'בקרית מיגון מורשית', text: 'בהסמכת פיקוד העורף.' },
];

const services = [
  {
    title: 'תכנון מגדלים',
    text: 'תכנון קונסטרוקטיבי של מגדלי מגורים ומשרדים רבי־קומות, משלב היסודות ועד להשלמת המבנה.',
    items: [
      'תכנון מגדלי מגורים ומשרדים בגובה של עד 30 קומות',
      'תכנון חניונים תת־קרקעיים משותפים למספר מגדלים',
      'תכנון קירות דיפון וקירות תמך לחפירות עמוקות',
      'תכנון סיסמי למבנים רבי־קומות',
    ],
  },
  {
    title: 'תכנון קונסטרוקציה',
    text: 'תכנון קונסטרוקטיבי למגוון רחב של מבנים ופרויקטים הנדסיים מורכבים.',
    items: [
      'תכנון מבני מגורים, בנייה רוויה ומבנים תת־קרקעיים',
      'תכנון מבני ציבור, משרדים, תעשייה ומסחר',
      'שדרוג סיסמי וחיזוק מבנים קיימים, לרבות במסגרת תמ"א 38',
      'תכנון קירות דיפון וקירות תמך',
    ],
  },
  {
    title: 'בקרת תכן מבנים',
    text: 'בקרת תכן קונסטרוקטיבית למבנים מורכבים, תוך בחינת איכות התכנון, יעילותו והכדאיות הכלכלית של הפרויקט.',
    items: [
      'בקרת תכן קונסטרוקטיבית למבנים מורכבים',
      'בחינת חלופות תכנון לשיפור היעילות ההנדסית',
      'איתור הזדמנויות להפחתת עלויות הבנייה',
      'שיפור הכדאיות הכלכלית של הפרויקט',
      'מתן חוות דעת מקצועיות בתחום הקונסטרוקציה',
    ],
  },
  {
    title: 'בקרת יציבות ומיגון',
    text: 'בקרת יציבות ומיגון למבנים במסגרת פעילות מכוני בקרה, בהתאם לדרישות התקינה והרגולציה.',
    items: [
      'בקרת יציבות מבנים לצורך מתן המלצה להיתר בנייה',
      'בקרת תוכניות ביצוע לצורך אישור תחילת עבודות',
      'בקרת תכן ויציבות במסגרת פעילות מכוני בקרה',
      'בדיקת התאמת המבנים לדרישות יציבות ומיגון',
    ],
  },
];

// The firm's way of working, shown under the service cards.
const steps = [
  { title: 'תכנון', text: 'תכנון שלד יעיל ובטוח, מהיסודות ועד הקומה האחרונה.' },
  { title: 'בקרה', text: 'בדיקת התכנון, היציבות והמיגון מול התקנים ותוכניות הביצוע.' },
  { title: 'ליווי והתייעלות', text: 'ליווי היזם לאורך הביצוע, עם פתרונות שחוסכים זמן וכסף.' },
];

import pKiryatAta from '../assets/projects/kiryat-ata.jpg';
import pFeichman from '../assets/projects/feichman-haifa.jpg';
import pMedical from '../assets/projects/medical-beer-sheva.jpg';
import pOrYam from '../assets/projects/or-yam.jpg';

// Homepage picks: only the name and the place, shown on hover or tap
const projects = [
  { img: pKiryatAta, name: 'שכונת מגורים', place: 'קרית אתא', focus: '50% 50%' },
  { img: pFeichman, name: 'פייכמן', place: 'חיפה', focus: '50% 50%' },
  { img: pMedical, name: 'מרכז רפואי', place: 'באר שבע', focus: '62% 50%' },
  { img: pOrYam, name: 'אור ים', place: 'אור עקיבא', focus: '30% 50%' },
];
---

<BaseLayout title="זמורוד חסן | הנדסת מבנים" overlayHeader>
  <!-- Hero -->
  <section class="hero">
    <video class="hero-video" src={url('/hero.mp4')} poster={url('/hero-poster.jpg')} autoplay muted loop playsinline preload="metadata" aria-hidden="true"></video>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="stack hero-copy">
        <div class="eyebrow-mono">ZMOROD HASSAN · CIVIL ENGINEERING · SINCE 2008</div>
        <h1>הנדסת מבנים, מהיסודות ועד הקומה ה‑30</h1>
        <p class="lead">
          תכנון קונסטרוקטיבי, בקרת תכן, יציבות ומיגון למגוון מבנים מורכבים, ממבני בוטיק, ציבור, תעשייה ומסחר ועד
          מגדלי מגורים ומשרדים המתנשאים לגובה של 30 קומות. בנוסף, החברה מספקת ליווי הנדסי, שיפור תהליכי תכנון
          וגיבוש פתרונות הנדסיים יעילים ואופטימליים.
        </p>
      </div>
      <div class="stats hero-stats" aria-label="המשרד במספרים">
        {stats.map((s) => (
          <div class="stat">
            <span class="stat-value" dir={s.suffix === '+' ? 'ltr' : undefined}>
              {s.prefix && <span class="stat-suffix">{s.prefix}</span>}<span data-count={s.value}>{s.value}</span><span class="stat-suffix">{s.suffix}</span>
            </span>
            <span class="muted stat-label">{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>


  <script>
    // Count each number up from 0 the first time the row scrolls into view.
    const counters = document.querySelectorAll<HTMLElement>('[data-count]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const run = (el: HTMLElement) => {
      const target = Number(el.dataset.count);
      const duration = 1600;
      let start = 0;
      const tick = (now: number) => {
        if (!start) start = now;
        const p = Math.min((now - start) / duration, 1);
        el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(tick);
      };
      const wait = el.closest('.hero') ? Math.max(0, 1900 - performance.now()) : 0;
      setTimeout(() => requestAnimationFrame(tick), wait);
    };
    if (!reduce && 'IntersectionObserver' in window) {
      counters.forEach((el) => (el.textContent = '0'));
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { run(e.target as HTMLElement); io.unobserve(e.target); }
        });
      }, { threshold: 0.5 });
      counters.forEach((el) => io.observe(el));
    }
  </script>

  <script>
    // Phones have no hover: a tap shows the name, tapping again or elsewhere hides it.
    const cards = document.querySelectorAll<HTMLElement>('.p-card');
    const touch = window.matchMedia('(hover: none)').matches;
    if (touch) {
      cards.forEach((c) => c.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = c.classList.contains('is-open');
        cards.forEach((o) => o.classList.remove('is-open'));
        if (!open) c.classList.add('is-open');
      }));
      document.addEventListener('click', () => cards.forEach((o) => o.classList.remove('is-open')));
    }
  </script>

  <!-- About -->
  <section class="section about" id="about">
    <div class="container stack about-inner">
      <div class="two-col">
        <figure class="portrait">
          <Image
            src={portrait}
            alt="זמורוד חסן, מהנדסת ובעלת החברה"
            widths={[440, 720, 932]}
            sizes="(max-width: 900px) 90vw, 440px"
          />
        </figure>
        <div class="stack gap-24">
          <span class="eyebrow">מי אנחנו</span>
          <h2 class="h2">אישה אחת, רזומה עשיר</h2>
          <p class="muted body">
            זמורוד חסן, הנדסת מבנים בע"מ, היא חברה בעלת ניסיון מקצועי של 17 שנים, המתמחה בתכנון קונסטרוקציה, בקרת
            תכן, בדיקות יציבות ומיגון. החברה עוסקת בתכנון קונסטרוקטיבי של מגוון רחב של מבנים מורכבים, בהם מגדלי מגורים
            ומשרדים בגובה של עד 30 קומות, מבנים מעל חניונים תת־קרקעיים, פרויקטים של בנייה רוויה, מבני בוטיק, מבני
            ציבור, מבני תעשייה ומסחר.
          </p>
          <p class="muted body">
            בנוסף, החברה מספקת שירותי ייעוץ וליווי הנדסי, חוות דעת מקצועיות וגיבוש פתרונות הנדסיים לשיפור תהליכי התכנון
            ולהתייעלות כלכלית.
          </p>
        </div>
      </div>

      <div class="milestones">
        {milestones.map((m) => (
          <div class="milestone">
            <span class="mono year">{m.year}</span>
            <span class="m-title">{m.title}</span>
            <span class="muted m-text">{m.text}</span>
          </div>
        ))}
      </div>

      <div class="stack gap-40">
        <div class="stack gap-16">
          <h3 class="h3">תחומי הפעילות והשירותים</h3>
          <p class="muted domains-lead">
            החברה מספקת מגוון שירותים הנדסיים, תוך הקפדה על מקצועיות, איכות התכנון, יעילות הנדסית והתייעלות כלכלית.
          </p>
        </div>
        <ul class="domain-grid">
          {activities.map((a) => (
            <li>
              <h4>{a.title}</h4>
              <p class="muted">{a.text}</p>
            </li>
          ))}
          <li class="domain-more">
            <a href={url('/#services')}>לפירוט השירותים ←</a>
          </li>
        </ul>
      </div>

    </div>
  </section>

  <!-- Vision -->
  <section class="section vision">
    <Image class="vision-bg" src={visionBg} alt="" widths={[960, 1600, 2400]} sizes="100vw" aria-hidden="true" />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="container stack gap-24">
      <span class="vision-label"><span aria-hidden="true"></span>החזון שלנו</span>
      <p class="vision-text">
        "להעניק שירות הנדסי מקצועי ואיכותי, תוך הקפדה על רמת תכנון גבוהה, עמידה בלוחות זמנים וגיבוש פתרונות הנדסיים
        יעילים וכדאיים מבחינה כלכלית המעניקים ליזם ערך מוסף לאורך כל שלבי הפרויקט."
      </p>

      <div class="listen">
        <div class="stack gap-16">
          <span class="vision-label"><span aria-hidden="true"></span>פודקאסט · {podcast.show}</span>
          <h3 class="listen-title">הסיפור שמאחורי המבנים</h3>
          <p class="listen-text">
            על האומץ להקים חברה משלה, על דרכה בתחום גברי מאוד ועל הסטנדרטים שהיא לא מוכנה להתפשר עליהם. האזינו לשיחה
            עם זמורוד חסן בפרק "{podcast.title}".
          </p>
          <a class="btn btn-light btn-sm" href={url('/press')}>לכל הכתבות והראיונות</a>
        </div>
        <iframe
          class="listen-player"
          src={`${podcast.embed}?theme=0`}
          title={`${podcast.title}, ${podcast.show}`}
          loading="lazy"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section" id="services">
    <div class="container stack gap-56">
      <div class="services-head">
        <div class="stack gap-16">
          <span class="eyebrow">שירותים</span>
          <h2 class="h2">מהתכנון ועד הבקרה</h2>
        </div>
        <p class="years">
          <span class="years-num mono">17</span>
          <span class="years-text">שנים של מבנים<br />שעומדים איתן</span>
        </p>
      </div>
      <div class="services">
        {services.map((s, i) => (
          <article class="service">
            <span class="mono num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p class="muted">{s.text}</p>
            <ul>
              {s.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>

      <!-- How the firm works: design, then review, then follow-through -->
      <div class="approach">
        <div class="stack gap-16">
          <span class="approach-eyebrow">הדרך שלנו</span>
          <h3 class="approach-title">מהתכנון ועד הביצוע, בפיקוח מלא</h3>
          <p>כל פרויקט עובר אצלנו שלושה שלבים, כדי שהמבנה יהיה בטוח, עומד בתקנים וכדאי כלכלית.</p>
        </div>
        <ol class="steps">
          {steps.map((s, i) => (
            <li>
              <span class="mono step-num">{String(i + 1).padStart(2, '0')}</span>
              <h4>{s.title}</h4>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="section projects">
    <div class="container stack gap-56">
      <div class="services-head">
        <div class="stack gap-16">
          <span class="eyebrow">פרויקטים</span>
          <h2 class="h2">הנדסה שרואים מרחוק</h2>
        </div>
        <p class="years">
          <span class="years-num mono" dir="ltr">400+</span>
          <span class="years-text">פרויקטים, מנהריה<br />ועד באר שבע</span>
        </p>
      </div>
      <div class="project-grid">
        {projects.map((p) => (
          <article class="p-card" tabindex="0">
            <Image class="p-img" src={p.img} alt={`${p.name}, ${p.place}`} widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 25vw" style={`object-position: ${p.focus}`} />
            <div class="p-over" aria-hidden="true">
              <h3 class="p-name">{p.name}</h3>
              <span class="p-place">{p.place}</span>
            </div>
          </article>
        ))}
      </div>
      <a class="text-link all-projects" href={url('/projects')}>לכל הפרויקטים ←</a>
    </div>
  </section>

  <!-- Contact -->
  <section class="section contact" id="contact">
    <div class="container contact-grid">
      <div class="stack gap-28 contact-copy">
        <h2 class="contact-title">נשמח לשמוע על הפרויקט שלכם</h2>
        <p class="contact-lead">מתכננים בניין חדש, צריכים בקרת תכן או חוות דעת על יציבות ומיגון? אנחנו מלווים יזמים, אדריכלים וקבלנים בתכנון הקונסטרוקציה, בבקרה מול התקנים ובליווי הנדסי באתר. ספרו לנו על הפרויקט, בכל שלב שבו הוא נמצא, ונחזור אליכם בהקדם.</p>
        <div class="actions">
          <a class="btn btn-gold" href={contact.phoneHref}>התקשרו עכשיו</a>
          <a class="btn btn-outline" href={`mailto:${contact.email}`}>שלחו מייל</a>
        </div>
        <dl class="contact-mini">
          <div><dt>טלפון</dt><dd><a class="mono" dir="ltr" href={contact.phoneHref}>{contact.phone}</a></dd></div>
          <div><dt>דוא"ל</dt><dd><a class="mono" dir="ltr" href={`mailto:${contact.email}`}>{contact.email}</a></dd></div>
        </dl>
      </div>
      <div class="contact-art"><CraneHero /></div>
    </div>
  </section>
</BaseLayout>

<style>
  .gap-16 { gap: 16px; }
  .gap-24 { gap: 24px; }
  .gap-28 { gap: 28px; }
  .gap-56 { gap: 56px; }
  .body { max-width: 600px; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 32px; }

  /* Hero */
  .hero {
    position: relative; overflow: hidden; background: var(--night); color: #FFFFFF;
    min-height: min(84svh, 860px); display: flex; align-items: center;
    padding: 188px var(--gutter) 88px;
  }
  .hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* Darker on the text side (right, RTL), so the copy reads over any frame */
  .hero-shade {
    position: absolute; inset: 0;
    background:
      linear-gradient(to left, rgba(6,11,17,.86) 0%, rgba(6,11,17,.62) 42%, rgba(6,11,17,.22) 100%),
      linear-gradient(to top, rgba(6,11,17,.55) 0%, transparent 35%);
  }
  .hero-inner { position: relative; width: 100%; }
  .hero-copy { gap: 28px; max-width: 780px; }
  .hero .eyebrow-mono { color: var(--gold); }
  .hero h1 { font-size: clamp(40px, 5.4vw, 78px); font-weight: 600; line-height: 1.08; color: #FFFFFF; }
  .hero .lead { max-width: 680px; color: rgba(255,255,255,.86); }
  /* Video first, then the copy rises in one line after another */
  @keyframes hero-rise { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
  .hero-copy > * { animation: hero-rise .9s cubic-bezier(.2,.7,.2,1) both; }
