---
/** Scroll + entrance choreography. One place so timings stay consistent. */
---

<script>
  import Lenis from 'lenis';
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* A looping hero video is motion too — hold on the poster frame instead. */
  const heroVideo = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (reduced && heroVideo) {
    heroVideo.removeAttribute('autoplay');
    heroVideo.pause();
  } else if (heroVideo) {
    // Drone footage reads as sluggish at native speed behind a static headline.
    const rate = 1.7;
    heroVideo.playbackRate = rate;
    heroVideo.addEventListener('loadedmetadata', () => (heroVideo.playbackRate = rate));
  }

  /* ---- Smooth scroll, driven by GSAP's ticker so ScrollTrigger stays in sync */
  if (!reduced) {
    const lenis = new Lenis({ duration: 1.15, smoothWheel: true });
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((t) => lenis.raf(t * 1000));
    gsap.ticker.lagSmoothing(0);

    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
      a.addEventListener('click', (e) => {
        const id = a.getAttribute('href');
        if (!id || id === '#') return;
        const target = document.querySelector(id);
        if (!target) return;
        e.preventDefault();
        lenis.scrollTo(target as HTMLElement, { offset: -80 });
      });
    });
  }

  /* ---- Hero entrance. Offset before the timeline builds, so the first
     tick never paints the un-offset state. */
  gsap.set('[data-reveal]', { y: 26 });

  const hero = gsap.timeline({ defaults: { ease: 'expo.out' } });

  hero.fromTo(
    '[data-hero-clip]',
    { clipPath: 'inset(0% 0% 100% 0%)' },
    { clipPath: 'inset(0% 0% 0% 0%)', duration: 1.5 }
  )
    .fromTo(
      '[data-hero-img]',
      { scale: 1.18 },
      { scale: 1, duration: 2.2, ease: 'power2.out' },
      '<'
    )
    .to(
      '[data-reveal]',
      { opacity: 1, y: 0, duration: 1.1, stagger: 0.09 },
      '-=0.35'
    );


  /* ---- Counters. Large figures count faster so they finish together. */
  document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
    const target = Number(el.dataset.count ?? 0);
    const obj = { n: 0 };
    gsap.to(obj, {
      n: target,
      duration: 2,
      ease: 'power2.out',
      delay: 0.9,
      onUpdate: () => {
        el.textContent = Math.round(obj.n).toLocaleString('en-US');
      },
    });
  });

  /* ---- Hero parallax: the tower drifts slower than the page */
  if (!reduced) {
    gsap.to('[data-hero-media]', {
      yPercent: 12,
      ease: 'none',
      scrollTrigger: {
        trigger: '#top',
        start: 'top top',
        end: 'bottom top',
        scrub: true,
      },
    });
  }

  /* ---- About ------------------------------------------------------------
     Hidden up front so it can never animate alongside the hero intro, then
     wired to scroll once that intro has finished. A visitor who lands mid-page
     (refresh, deep link) gets it wired immediately instead. */
  if (document.querySelector('#about')) {
    gsap.set('[data-about-in]', { opacity: 0, y: 28 });
    gsap.set('[data-about-clip]', { clipPath: 'inset(0% 0% 100% 0%)' });

    const initAbout = () => {
      gsap.to('[data-about-in]', {
        opacity: 1,
        y: 0,
        duration: 1,
        stagger: 0.07,
        ease: 'expo.out',
        scrollTrigger: { trigger: '#about', start: 'top 68%' },
      });

      gsap.to('[data-about-clip]', {
        clipPath: 'inset(0% 0% 0% 0%)',
        duration: 1.3,
        ease: 'expo.out',
        scrollTrigger: { trigger: '#about', start: 'top 68%' },
      });

      if (!reduced) {
        gsap.to('[data-about-media]', {
          yPercent: -7,
          ease: 'none',
          scrollTrigger: { trigger: '#about', start: 'top bottom', end: 'bottom top', scrub: true },
        });
      }
    };

    if (window.scrollY > 120) initAbout();
    else hero.eventCallback('onComplete', initAbout);
  }
</script>
