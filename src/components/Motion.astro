---
/** Scroll + entrance choreography for every page. One place so timings stay
    consistent, and so sections that aren't on the current page are skipped. */
---

<script>
  import Lenis from 'lenis';
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const has = (sel: string) => Boolean(document.querySelector(sel));

  /* ---- Smooth scroll, driven by GSAP's ticker so ScrollTrigger stays in sync */
  if (!reduced) {
    const lenis = new Lenis({ duration: 1.15, smoothWheel: true });
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((t) => lenis.raf(t * 1000));
    gsap.ticker.lagSmoothing(0);

    // Delegated so it also catches absolute links like /website/#about, which
    // the nav uses in order to work from any page.
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement)?.closest?.('a');
      if (!a || a.target === '_blank') return;

      const url = new URL(a.href, location.href);
      if (url.pathname !== location.pathname || !url.hash) return;

      const target = document.querySelector(url.hash);
      if (!target) return;

      e.preventDefault();
      lenis.scrollTo(target as HTMLElement, { offset: -80 });
    });
  }

  /* ---- Hero -------------------------------------------------------------- */
  const hero = gsap.timeline({ defaults: { ease: 'expo.out' } });

  if (has('#top')) {
    const heroVideo = document.querySelector<HTMLVideoElement>('[data-hero-video]');
    if (reduced && heroVideo) {
      heroVideo.removeAttribute('autoplay');
      heroVideo.pause();
    } else if (heroVideo) {
      // Drone footage reads as sluggish at native speed behind a static headline.
      const rate = 1.7;
      heroVideo.playbackRate = rate;
      heroVideo.addEventListener('loadedmetadata', () => (heroVideo.playbackRate = rate));
    }

    // Offset before the timeline builds, so the first tick never paints the
    // un-offset state.
    gsap.set('[data-reveal]', { y: 26 });

    hero
      .fromTo(
        '[data-hero-clip]',
        { clipPath: 'inset(0% 0% 100% 0%)' },
        { clipPath: 'inset(0% 0% 0% 0%)', duration: 1.5 }
      )
      .fromTo('[data-hero-img]', { scale: 1.18 }, { scale: 1, duration: 2.2, ease: 'power2.out' }, '<')
      .to('[data-reveal]', { opacity: 1, y: 0, duration: 1.1, stagger: 0.09 }, '-=0.35');

    if (!reduced) {
      gsap.to('[data-hero-media]', {
        yPercent: 12,
        ease: 'none',
        scrollTrigger: { trigger: '#top', start: 'top top', end: 'bottom top', scrub: true },
      });
    }
  }

  /* ---- Counters. Large figures count faster so they finish together. ----- */
  document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
    const target = Number(el.dataset.count ?? 0);
    const obj = { n: 0 };
    gsap.to(obj, {
      n: target,
      duration: 2,
      ease: 'power2.out',
      delay: 0.9,
      onUpdate: () => {
        el.textContent = Math.round(obj.n).toLocaleString('en-US');
      },
    });
  });

  /* ---- About -------------------------------------------------------------
     Hidden up front so it can never animate alongside the hero intro, then
     wired to scroll once that intro has finished. A visitor who lands mid-page
     (refresh, deep link) gets it wired immediately instead. */
  if (has('#about')) {
    gsap.set('[data-about-in]', { opacity: 0, y: 28 });
    gsap.set('[data-about-clip]', { clipPath: 'inset(0% 0% 100% 0%)' });

    const initAbout = () => {
      gsap.to('[data-about-in]', {
        opacity: 1,
        y: 0,
        duration: 1,
        stagger: 0.07,
        ease: 'expo.out',
        scrollTrigger: { trigger: '#about', start: 'top 68%' },
      });

      gsap.to('[data-about-clip]', {
        clipPath: 'inset(0% 0% 0% 0%)',
        duration: 1.3,
        ease: 'expo.out',
        scrollTrigger: { trigger: '#about', start: 'top 68%' },
      });

      if (!reduced) {
        gsap.to('[data-about-media]', {
          yPercent: -7,
          ease: 'none',
          scrollTrigger: { trigger: '#about', start: 'top bottom', end: 'bottom top', scrub: true },
        });
      }
    };

    if (has('#top') && window.scrollY <= 120) hero.eventCallback('onComplete', initAbout);
    else initAbout();
  }

  /* ---- Generic section reveals ------------------------------------------ */
  const reveal = (scope: string, itemSel: string, cardSel?: string) => {
    if (!has(scope)) return;

    gsap.from(itemSel, {
      opacity: 0,
      y: 28,
      duration: 1,
      stagger: 0.08,
      ease: 'expo.out',
      scrollTrigger: { trigger: scope, start: 'top 72%' },
    });

    if (cardSel) {
      gsap.utils.toArray<HTMLElement>(cardSel).forEach((card) => {
        gsap.from(card, {
          opacity: 0,
          y: 46,
          duration: 1.1,
          ease: 'expo.out',
          scrollTrigger: { trigger: card, start: 'top 88%' },
        });
      });
    }
  };

  reveal('#projects', '[data-proj-in]', '[data-proj-card]');
  reveal('#services', '[data-srv-in]', '[data-srv-card]');
  reveal('#contact', '[data-ct-in]');
  reveal('#page-head', '[data-head-in]');
  reveal('#more-projects', '[data-more-in]');
  reveal('#service-rows', '[data-row]');
  reveal('#recognition', '[data-rec-in]');
</script>
