---
import { href, projects } from '../lib/site';

interface Props {
  /** On the projects page the PageHead already carries the title. */
  headless?: boolean;
}
const { headless = false } = Astro.props;

// Same framed button as the vision CTA in About. Rendered twice: in the
// heading row from `md` up, and under the grid on mobile where a control
// above the fold is easy to miss.
const cta =
  'group items-center gap-4 border border-paper-3 px-9 py-4.5 font-sans text-base text-ink-900 transition-colors duration-400 hover:border-gold-600 hover:text-gold-700';
---

<section id="projects" class="relative bg-paper">
  <div class="relative overflow-hidden pt-24 pb-24 lg:pt-32 lg:pb-32">
    <div class="absolute inset-0 bg-blueprint-ink opacity-40"></div>

    <div class="relative mx-auto max-w-[100rem] px-6 lg:pe-12 lg:ps-[clamp(4.5rem,6vw,9rem)]">
      <!-- Heading -->
      <div class="flex flex-wrap items-end justify-between gap-8" hidden={headless}>
        <h2
          class="font-display text-[clamp(2.6rem,5vw,4.5rem)] leading-[1.02] font-light text-ink-900"
          data-proj-in
        >
          פרויקטים <span class="text-gold-gradient-ink">נבחרים</span>
        </h2>

        <a href={href('/projects')} class:list={['hidden md:inline-flex', cta]} data-proj-in>
          כל הפרויקטים
          <svg
            class="size-4 -scale-x-100 transition-transform duration-400 ease-[var(--ease-out-expo)] group-hover:-translate-x-1.5"
            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>

      <!-- Grid — the name is the only copy on the card -->
      <div class:list={['grid gap-6 md:grid-cols-2 lg:gap-8', headless ? 'mt-0' : 'mt-16']}>
        {
          projects.map((p, i) => (
            <article
              class="group relative aspect-[4/3] overflow-hidden border border-paper-3 bg-paper-2 transition-colors duration-500 hover:border-gold-600"
              data-proj-card
            >
              {/* Placeholder until real photography lands */}
              <div class="absolute inset-0 bg-blueprint-ink" />

              {/* Drafting corner marks */}
              <span class="absolute top-4 start-4 size-7 border-s border-t border-gold-600/70" />
              <span class="absolute bottom-4 end-4 size-7 border-e border-b border-gold-600/70" />

              <span class="annot nums absolute top-4 end-5 text-gold-700">
                {String(i + 1).padStart(2, '0')}
              </span>

              {/* Name. Always up on touch, where there is no hover to reveal
                  it; fades in from `lg`. */}
              <div
                class="absolute inset-0 grid place-items-center bg-paper/85 transition-opacity duration-500 lg:opacity-0 lg:group-hover:opacity-100"
              >
                <h3 class="px-6 text-center font-display text-2xl text-balance text-ink-900 lg:text-3xl">
                  {p.name}
                </h3>
              </div>
            </article>
          ))
        }
      </div>

      {
        !headless && (
          <div class="mt-12 flex justify-center md:hidden" data-proj-in>
            <a href={href('/projects')} class:list={['inline-flex', cta]}>
              כל הפרויקטים
              <svg
                class="size-4 -scale-x-100 transition-transform duration-400 ease-[var(--ease-out-expo)] group-hover:-translate-x-1.5"
                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"
              >
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          </div>
        )
      }
    </div>
  </div>
</section>
