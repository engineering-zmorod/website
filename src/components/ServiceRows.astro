---
import { Image } from 'astro:assets';
import design from '../../assets/service-design.avif';
import review from '../../assets/service-review.avif';
import supervision from '../../assets/service-supervision.avif';
import { services } from '../lib/site';

const media = [design, review, supervision];
---

<section id="service-rows" class="relative overflow-hidden bg-ink-950 py-20 lg:py-28">
  <div class="absolute inset-0 bg-blueprint opacity-30"></div>
  <div class="pointer-events-none absolute inset-0 bg-grain opacity-[0.12] mix-blend-overlay"></div>

  <div class="relative mx-auto max-w-[100rem] px-6 lg:pe-12 lg:ps-[clamp(4.5rem,6vw,9rem)]">
    {
      services.map((s, i) => (
        <article
          class:list={[
            'grid items-center gap-10 border-t border-ink-800 py-16 lg:grid-cols-2 lg:gap-20 lg:py-24',
            i === 0 && 'border-t-0 pt-0',
          ]}
          data-row
        >
          {/* Media. Alternating side, so the page doesn't march in one column. */}
          <div class:list={['relative', i % 2 === 1 ? 'lg:order-2' : 'lg:order-1']}>
            <div class="relative aspect-[5/4] overflow-hidden bg-ink-850" data-row-clip>
              <Image
                src={media[i]}
                alt=""
                widths={[600, 1000]}
                sizes="(max-width: 1024px) 92vw, 44vw"
                class="h-full w-full object-cover"
              />
              <div class="pointer-events-none absolute inset-0 bg-ink-950/40" />
            </div>

            <span class="absolute -top-4 -start-4 size-12 border-s border-t border-gold-800/60" />
            <span class="absolute -bottom-4 -end-4 size-12 border-e border-b border-gold-800/60" />
          </div>

          {/* Copy */}
          <div class:list={[i % 2 === 1 ? 'lg:order-1' : 'lg:order-2']}>
            <span class="annot nums text-gold-600">{String(i + 1).padStart(2, '0')}</span>

            <h2 class="mt-4 font-display text-[clamp(2rem,3.4vw,3rem)] leading-tight font-light text-steel-100">
              {s.name}
            </h2>

            <p class="mt-5 max-w-xl font-sans text-lg leading-relaxed text-steel-300">{s.lead}</p>

            <ul class="mt-8 space-y-4 border-t border-ink-800 pt-8">
              {s.items.map((it) => (
                <li class="flex gap-4 font-sans text-base leading-relaxed text-steel-300 lg:text-lg">
                  <span class="mt-3 block h-px w-5 shrink-0 bg-gold-600" />
                  {it}
                </li>
              ))}
            </ul>

          </div>
        </article>
      ))
    }
  </div>
</section>
