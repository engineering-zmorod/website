---
import { aboutExtra } from '../lib/site';
---

<section id="recognition" class="relative overflow-hidden bg-ink-950 pb-24 lg:pb-32">
  <div class="absolute inset-0 bg-blueprint opacity-30"></div>

  <div class="relative mx-auto max-w-[100rem] px-6 lg:pe-12 lg:ps-[clamp(4.5rem,6vw,9rem)]">
    <!-- Vision -->
    <figure class="border-t border-ink-800 pt-14" data-rec-in>
      <p class="annot-he text-gold-600">החזון שלנו</p>
      <blockquote
        class="mt-6 max-w-4xl font-display text-[clamp(1.6rem,3vw,2.6rem)] leading-snug font-light text-steel-100"
      >
        “{aboutExtra.vision}”
      </blockquote>
    </figure>

    <div class="mt-20 grid gap-16 lg:grid-cols-2 lg:gap-24">
      <!-- Awards -->
      <div>
        <h2 class="font-display text-3xl font-light text-steel-100 lg:text-4xl" data-rec-in>
          הצטיינות
        </h2>

        <ul class="mt-8 border-t border-ink-800">
          {
            aboutExtra.awards.map((a) => (
              <li class="flex gap-6 border-b border-ink-800 py-6" data-rec-in>
                <span class="annot nums shrink-0 pt-1.5 text-gold-500">{a.year}</span>
                <div>
                  <h3 class="font-display text-xl text-steel-100 lg:text-2xl">{a.title}</h3>
                  <p class="mt-1.5 font-sans text-base text-steel-400">{a.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Press -->
      <div>
        <h2 class="font-display text-3xl font-light text-steel-100 lg:text-4xl" data-rec-in>
          מן העיתונות
        </h2>

        <ul class="mt-8 border-t border-ink-800">
          {
            aboutExtra.press.map((p) => (
              <li class="flex gap-6 border-b border-ink-800 py-6" data-rec-in>
                <span class="annot nums shrink-0 pt-1.5 text-gold-500">{p.year}</span>
                <div>
                  <p class="font-display text-xl text-steel-100 lg:text-2xl">“{p.quote}”</p>
                  <p class="mt-1.5 font-sans text-base text-steel-400">{p.source}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Training -->
    <div class="mt-20">
      <h2 class="font-display text-3xl font-light text-steel-100 lg:text-4xl" data-rec-in>
        הכשרות נוספות
      </h2>

      <ul class="mt-8 grid gap-x-10 gap-y-4 border-t border-ink-800 pt-8 sm:grid-cols-2">
        {
          aboutExtra.training.map((t) => (
            <li class="flex gap-4 font-sans text-base leading-relaxed text-steel-300 lg:text-lg" data-rec-in>
              <span class="mt-3 block h-px w-5 shrink-0 bg-gold-600" />
              {t}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
