---
import { Image } from 'astro:assets';
import towers from '../../assets/hero-tower.avif';
import design from '../../assets/service-design.avif';
import review from '../../assets/service-review.avif';
import supervision from '../../assets/service-supervision.avif';
import { services } from '../lib/site';

// Order matches `services` — towers first.
const media = [towers, design, review, supervision];
---

{/* Continues the light half of the page: About above and Projects below are
    both paper, so this panel needs no diagonal of its own. */}
<section id="services" class="relative bg-paper">
  <div class="relative overflow-hidden pt-24 pb-24 lg:pt-32 lg:pb-32">
    <div class="absolute inset-0 bg-blueprint-ink opacity-40"></div>

    <div class="relative mx-auto max-w-[100rem] px-6 lg:pe-12 lg:ps-[clamp(4.5rem,6vw,9rem)]">
      <h2
        class="font-display text-[clamp(2.6rem,5vw,4.5rem)] leading-[1.02] font-light text-ink-900"
        data-srv-in
      >
        שירותי <span class="text-gold-gradient-ink">החברה</span>
      </h2>

      {/* Same card at every width — photo plate on top, copy below on the
          paper. Two up from `sm`; no hover-reveal, so everything is readable
          without interaction. */}
      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:mt-16 lg:gap-8">
        {
          services.map((s, i) => (
            <article
              class="group flex cursor-pointer flex-col border border-paper-3 bg-paper-2/50 transition-colors duration-500 hover:border-gold-600"
              data-srv-card
              data-lightbox
              role="button"
              tabindex="0"
              aria-label={s.name}
            >
              {/* Lightbox renders on ink, so this copy stays light. */}
              <template data-lb-content>
                <span class="annot nums text-gold-500">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="mt-2 font-display text-2xl text-steel-100 lg:text-3xl">{s.name}</h3>
                <p class="mt-2.5 font-sans text-base leading-relaxed text-steel-200">{s.lead}</p>
                <ul class="mt-5 space-y-2 border-t border-steel-100/15 pt-5">
                  {s.items.map((it) => (
                    <li class="flex gap-3 font-sans text-[0.95rem] leading-relaxed text-steel-300">
                      <span class="mt-2.5 block size-1 shrink-0 bg-gold-600" />
                      {it}
                    </li>
                  ))}
                </ul>
              </template>

              {/* Photo plate. No dark wash any more — nothing is set over it,
                  so it can sit clean against the paper. */}
              <div class="relative aspect-[4/3] overflow-hidden">
                <Image
                  src={media[i]}
                  alt=""
                  widths={[480, 900, 1400]}
                  sizes="(max-width: 640px) 92vw, 46vw"
                  class="h-full w-full object-cover transition-transform duration-[900ms] ease-[var(--ease-out-expo)] group-hover:scale-[1.04]"
                />
                <span class="pointer-events-none absolute inset-x-0 bottom-0 h-px bg-gold-600/70" />
              </div>

              <div class="flex grow flex-col p-7 lg:p-9">
                <span class="annot nums text-gold-700">{String(i + 1).padStart(2, '0')}</span>

                <h3 class="mt-2.5 font-display text-2xl leading-snug text-ink-900 lg:text-[1.75rem]">
                  {s.name}
                </h3>

                <p class="mt-3 font-sans text-base leading-relaxed text-slate">{s.lead}</p>

                <ul class="mt-6 space-y-2.5 border-t border-paper-3 pt-6">
                  {s.items.map((it) => (
                    <li class="flex gap-3 font-sans text-[0.95rem] leading-relaxed text-slate">
                      <span class="mt-2.5 block size-1 shrink-0 bg-gold-600" />
                      {it}
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
