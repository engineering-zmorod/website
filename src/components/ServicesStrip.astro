---
// UNUSED — kept for reference. Hover-to-expand panel strip version of the
// services section. Swap it in for Services.astro to use it.
import { Image } from 'astro:assets';
import design from '../../assets/service-design.avif';
import review from '../../assets/service-review.avif';
import supervision from '../../assets/service-supervision.avif';
import towers from '../../assets/hero-tower.avif';
import { services } from '../lib/site';

const media = [design, review, supervision, towers];
---

<section id="services" class="relative overflow-hidden bg-ink-950 py-24 lg:py-32">
  <div class="absolute inset-0 bg-blueprint opacity-30"></div>
  <div class="pointer-events-none absolute inset-0 bg-grain opacity-[0.12] mix-blend-overlay"></div>

  <div class="relative mx-auto max-w-[100rem] px-6 lg:pe-12 lg:ps-[clamp(4.5rem,6vw,9rem)]">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2
        class="font-display text-[clamp(2.6rem,5vw,4.5rem)] leading-[1.02] font-light text-steel-100"
        data-srv-in
      >
        שירותי <span class="text-gold-gradient">החברה</span>
      </h2>

      <p class="annot-he hidden text-steel-500 lg:block" data-srv-in>
        העבירו את העכבר לפרטים
      </p>
    </div>

    {/* One strip on desktop — panels expand on hover. Stacks on small screens,
        where hover doesn't exist and everything shows at once. */}
    <div class="mt-14 flex flex-col gap-10 lg:h-[36rem] lg:flex-row lg:gap-3">
      {
        services.map((s, i) => (
          <article
            class="group relative overflow-hidden border border-ink-800 lg:basis-0 lg:grow lg:transition-[flex-grow] lg:duration-[800ms] lg:ease-[var(--ease-out-expo)] lg:hover:grow-[3.2]"
            data-srv-card
          >
            {/* Media */}
            <div class="relative aspect-[4/3] lg:absolute lg:inset-0 lg:aspect-auto">
              <Image
                src={media[i]}
                alt=""
                widths={[480, 900, 1400]}
                sizes="(max-width: 1024px) 92vw, 45vw"
                class="h-full w-full object-cover transition-transform duration-[1200ms] ease-[var(--ease-out-expo)] lg:scale-110 lg:group-hover:scale-100"
              />
              <div class="absolute inset-0 bg-ink-950/55 transition-colors duration-700 lg:bg-ink-950/75 lg:group-hover:bg-ink-950/45" />
              <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-ink-950 via-ink-950/70 to-transparent" />
            </div>

            {/* Collapsed label — vertical, like a spine */}
            <div class="pointer-events-none absolute inset-0 hidden lg:block">
              <span class="annot nums absolute top-6 start-0 w-full text-center text-gold-500">
                {String(i + 1).padStart(2, '0')}
              </span>
              {/* Horizontal: vertical writing-mode mangles Hebrew glyphs, and
                  the collapsed panel is wide enough to read across. */}
              <span
                class="absolute inset-x-0 bottom-8 px-5 text-center font-display text-xl leading-snug text-balance text-steel-100 transition-opacity duration-300 group-hover:opacity-0 xl:text-2xl"
              >
                {s.name}
              </span>
            </div>

            {/* Expanded content */}
            <div class="relative p-6 lg:absolute lg:inset-x-0 lg:bottom-0 lg:p-9 lg:opacity-0 lg:transition-opacity lg:delay-100 lg:duration-500 lg:group-hover:opacity-100">
              <span class="annot nums text-gold-500 lg:hidden">{String(i + 1).padStart(2, '0')}</span>

              <h3 class="mt-2 font-display text-2xl text-steel-100 lg:mt-0 lg:text-3xl">{s.name}</h3>
              <p class="mt-3 font-sans text-base leading-relaxed text-steel-300">{s.lead}</p>

              <ul class="mt-5 space-y-2.5 border-t border-ink-700 pt-5">
                {s.items.map((it) => (
                  <li class="flex gap-3 font-sans text-base leading-relaxed text-steel-400">
                    <span class="mt-2.5 block size-1 shrink-0 bg-gold-600" />
                    {it}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
