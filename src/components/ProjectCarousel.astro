---
import { moreProjects } from '../lib/site';
---

<section id="more-projects" class="relative overflow-hidden bg-ink-950 py-24 lg:py-32">
  <div class="absolute inset-0 bg-blueprint opacity-30"></div>

  <div class="relative">
    <div
      class="mx-auto flex max-w-[100rem] flex-wrap items-end justify-between gap-6 px-6 lg:pe-12 lg:ps-[clamp(4.5rem,6vw,9rem)]"
    >
      <h2 class="font-display text-[clamp(2rem,3.6vw,3.2rem)] font-light text-steel-100" data-more-in>
        שאר <span class="text-gold-gradient">הפרויקטים</span>
      </h2>

      <!-- Arrows. Flipped for RTL: "prev" moves towards the start edge. -->
      <div class="flex items-center gap-3" data-more-in>
        <button
          type="button"
          class="grid size-12 place-items-center border border-ink-700 text-steel-300 transition-colors duration-300 hover:border-gold-700 hover:text-gold-300 disabled:opacity-30"
          aria-label="הקודם"
          data-rail-prev
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <path d="m9 6 6 6-6 6" />
          </svg>
        </button>
        <button
          type="button"
          class="grid size-12 place-items-center border border-ink-700 text-steel-300 transition-colors duration-300 hover:border-gold-700 hover:text-gold-300 disabled:opacity-30"
          aria-label="הבא"
          data-rail-next
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <path d="m15 6-6 6 6 6" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Rail. Bleeds off the end edge so it reads as continuing. -->
    <div
      class="mt-12 flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth pb-4 ps-6 pe-6 lg:ps-[clamp(4.5rem,6vw,9rem)] no-scrollbar"
      data-rail
    >
      {
        moreProjects.map((p, i) => (
          <article
            class="group w-[78vw] shrink-0 snap-start sm:w-[46vw] lg:w-[24rem]"
            data-rail-item
          >
            <div class="relative aspect-[4/3] overflow-hidden bg-ink-850">
              <div class="absolute inset-0 bg-blueprint opacity-70" />
              <div class="absolute inset-0 grid place-items-center">
                <span class="annot-he text-ink-600">תמונה בקרוב</span>
              </div>
              <span class="absolute top-4 start-4 size-6 border-s border-t border-gold-800/60" />
              <span class="absolute bottom-4 end-4 size-6 border-e border-b border-gold-800/60" />
              <span class="annot nums absolute top-4 end-5 text-ink-600">
                {String(i + 5).padStart(2, '0')}
              </span>
            </div>

            <p class="annot-he mt-5 text-gold-600">{p.place}</p>
            <h3 class="mt-2 font-display text-xl text-steel-100 lg:text-2xl">{p.name}</h3>
            <p class="mt-2 font-mono text-sm text-steel-400">{p.fact}</p>
          </article>
        ))
      }

      <!-- Trailing spacer so the last card can reach the start edge -->
      <span class="w-2 shrink-0" aria-hidden="true"></span>
    </div>
  </div>
</section>

<script>
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const prev = document.querySelector<HTMLButtonElement>('[data-rail-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-rail-next]');

  if (rail && prev && next) {
    const step = () => {
      const card = rail.querySelector<HTMLElement>('[data-rail-item]');
      if (!card) return rail.clientWidth * 0.8;
      const gap = parseFloat(getComputedStyle(rail).columnGap || '24');
      return card.offsetWidth + gap;
    };

    // scrollLeft runs negative in RTL, so direction is handled by sign alone.
    prev.addEventListener('click', () => rail.scrollBy({ left: step(), behavior: 'smooth' }));
    next.addEventListener('click', () => rail.scrollBy({ left: -step(), behavior: 'smooth' }));

    const sync = () => {
      const max = rail.scrollWidth - rail.clientWidth;
      const x = Math.abs(rail.scrollLeft);
      prev.disabled = x < 8;
      next.disabled = x > max - 8;
    };
    sync();
    rail.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
  }
</script>
