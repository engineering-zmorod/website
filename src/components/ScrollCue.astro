---
/** Used twice in the hero: beside the title on small screens, under the
    figures from lg up. */
---

<a href="#about" class="group flex flex-col items-center gap-2.5 lg:gap-3" aria-label="גלול למטה">
  <span
    class="annot-he whitespace-nowrap text-gold-500 transition-colors duration-300 group-hover:text-gold-300"
  >
    גלול למטה
  </span>

  <span class="relative block h-10 w-px overflow-hidden bg-ink-600 lg:h-14">
    <span class="absolute inset-x-0 top-0 h-5 animate-[cue_2.2s_ease-in-out_infinite] bg-gold-400"></span>
  </span>

  <svg
    class="size-4 animate-[nudge_2.2s_ease-in-out_infinite] text-gold-500 transition-colors duration-300 group-hover:text-gold-300"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    aria-hidden="true"
  >
    <path d="m6 9 6 6 6-6" />
  </svg>
</a>
