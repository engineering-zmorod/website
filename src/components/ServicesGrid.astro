---
import { services } from '../lib/site';

/** Thin line marks, one per service — drawn to match the drafting language
    rather than pulled from a generic icon set. Order matches `services`. */
const icons = [
  // towers
  `<path d="M3 21h18"/><path d="M5 21V9l4-3v15"/><path d="M14 21V3l5 3.5V21"/>
   <path d="M7 12h0M7 15h0M7 18h0M16.5 9h0M16.5 12h0M16.5 15h0M16.5 18h0"/>`,
  // structural design sheet
  `<path d="M4 4h16v16H4z"/><path d="M4 8h16M8 8v12"/><path d="M11 11l6 6M17 11l-6 6"/>`,
  // design review
  `<path d="M6 3h9l4 4v9"/><path d="M15 3v4h4"/><path d="M6 3v14"/>
   <circle cx="14" cy="16" r="4"/><path d="M17 19l3 3"/>`,
  // site supervision — crane
  `<path d="M3 21h18"/><path d="M8 21V4"/><path d="M8 4h11l-2 3H8"/>
   <path d="M8 4 3.5 9"/><path d="M14 7v4"/><path d="M12.5 11h3l-1.5 2.5z"/>`,
];
---

{/* The section sits on the page as a single panel rather than a full-bleed
    band, so it reads as one block against the paper above it. */}
<section id="services" class="relative bg-paper py-20 lg:py-28">
  <div class="mx-auto max-w-[100rem] px-6 lg:pe-12 lg:ps-[clamp(4.5rem,6vw,9rem)]">
    <div class="relative border border-paper-3 bg-paper-2 px-6 py-16 sm:px-10 lg:px-16 lg:py-20">
    <h2
      class="text-center font-display text-[clamp(2.2rem,4.2vw,3.6rem)] leading-[1.08] font-light text-ink-900"
      data-srv-in
    >
      שירותי <span class="text-gold-gradient-ink">החברה</span>
    </h2>

    <p
      class="mx-auto mt-5 max-w-2xl text-center font-sans text-base leading-relaxed text-balance text-slate lg:text-lg"
      data-srv-in
    >
      החברה מתמחה בעיקר במתן השירותים ההנדסיים הבאים:
    </p>

    {/* A schedule, not a card grid: every row on a hairline, the index and
        icon anchoring the start edge. */}
      <ul class="mt-14 border-t border-paper-3 lg:mt-16">
      {
        services.map((s, i) => (
          <li class="group border-b border-paper-3" data-srv-card>
            <div class="relative grid gap-6 py-10 lg:grid-cols-[5.5rem_minmax(0,0.9fr)_minmax(0,1.35fr)] lg:items-start lg:gap-14 lg:py-14">
              {/* the rule that fills in on hover */}
              <span class="pointer-events-none absolute inset-y-0 start-0 w-0.5 origin-top scale-y-0 bg-gold-600 transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:scale-y-100" />

              <div class="flex items-center gap-5 lg:block">
                <span class="annot nums text-gold-600">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <svg
                  class="size-10 text-gold-600 transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:-translate-y-1 lg:mt-5 lg:size-12"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={icons[i]}
                />
              </div>

              <h3 class="font-display text-2xl leading-snug text-ink-900 lg:text-[2rem]">
                {s.name}
              </h3>

              <div>
                <p class="font-sans text-base leading-relaxed text-slate lg:text-lg">{s.lead}</p>

                <ul class="mt-5 grid gap-x-10 gap-y-2 sm:grid-cols-2">
                  {s.items.map((it) => (
                    <li class="flex gap-3 font-sans text-[0.95rem] leading-relaxed text-slate">
                      <span class="mt-2.5 block size-1 shrink-0 bg-gold-600" />
                      {it}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </li>
        ))
      }
      </ul>
    </div>
  </div>
</section>
