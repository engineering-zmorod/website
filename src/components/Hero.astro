---
import { getImage } from 'astro:assets';
import posterSrc from '../../assets/hero-poster.jpg';
import { href, site, stats } from '../lib/site';

// Video lives in public/ — Astro's asset pipeline only processes images.
const videoSrc = `${import.meta.env.BASE_URL}/hero.mp4`.replace(/\/+/g, '/');

// Poster carries first paint, so it goes through the image pipeline.
const poster = await getImage({ src: posterSrc, width: 1400, format: 'webp', quality: 55 });
---

<section id="top" class="relative min-h-svh overflow-hidden bg-ink-950">
  <!-- Drafting surface -->
  <div class="absolute inset-0 bg-blueprint opacity-[0.55]"></div>
  <div class="pointer-events-none absolute inset-0 bg-grain opacity-[0.16] mix-blend-overlay"></div>

  <!-- Tower, bleeding off the end edge -->
  <div
    class="absolute inset-y-0 end-0 w-full lg:w-[68%]"
    data-hero-media
  >
    <div class="h-full w-full overflow-hidden" data-hero-clip>
      <video
        class="h-full w-full object-cover object-center"
        poster={poster.src}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-hidden="true"
        data-hero-video
        data-hero-img
      >
        <source src={videoSrc} type="video/mp4" />
      </video>
    </div>

    <!-- Fade the photograph into the drafting surface -->
    <div class="absolute inset-0 bg-ink-950/78 lg:bg-ink-950/50"></div>
    <div
      class="absolute inset-0 hero-fade"
    >
    </div>
    <div class="absolute inset-x-0 bottom-0 h-48 bg-gradient-to-t from-ink-950 to-transparent"></div>
    <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-ink-950/80 to-transparent"></div>
  </div>

  <!-- Title-block rail, like the edge of a drawing sheet -->
  <div class="pointer-events-none absolute inset-y-0 start-0 hidden w-12 border-e border-ink-800/70 xl:block">
    <div class="absolute bottom-14 start-1/2 -translate-x-1/2 [writing-mode:vertical-rl] rotate-180">
      <span class="annot text-steel-500">ZMOROD HASSAN · CIVIL ENGINEERING</span>
    </div>
    <div class="absolute top-32 start-1/2 h-24 w-px -translate-x-1/2 bg-gradient-to-b from-gold-700 to-transparent"></div>
  </div>

  <!-- Content -->
  <div class="relative flex min-h-svh flex-col justify-center px-6 pt-28 pb-16 lg:pb-24 lg:pe-12 lg:ps-[clamp(4.5rem,6vw,9rem)]">
    <div class="max-w-2xl">
      <p class="annot-he flex items-center gap-3" data-reveal>
        <span class="inline-block h-px w-8 bg-gold-600"></span>
        <span class="nums font-mono tracking-[0.2em]">SINCE {site.since}</span>
        <span class="text-steel-500">·</span>
        <span>גוליס</span>
      </p>

      <h1 class="mt-7 font-display leading-[0.92] tracking-tight">
        <span class="block text-[clamp(3rem,9vw,6.5rem)] font-light text-steel-100" data-reveal>
          זמורוד חסן
        </span>
        <span
          class="mt-2 block text-gold-gradient text-[clamp(1.6rem,4vw,3rem)] font-medium"
          data-reveal
        >
          הנדסת מבנים
        </span>
      </h1>

      <div class="mt-9 max-w-md rule-dim" data-reveal></div>

      <p
        class="mt-8 max-w-xl font-sans text-xl leading-relaxed text-steel-300 lg:text-2xl"
        data-reveal
      >
        {site.tagline}
      </p>

      <p class="mt-5 max-w-lg font-sans text-base leading-relaxed text-steel-400 lg:text-lg" data-reveal>
        מגדלים עד 30 קומות מעל חניונים תת־קרקעיים, בנייה רוויה ומבני בוטיק — לצד מבני ציבור, תעשייה ומסחר. בהתמחות תכנון לרעידות אדמה וחיזוק מבנים קיימים.
      </p>

      <div class="mt-11 flex flex-wrap items-center gap-4" data-reveal>
        <a
          href={href('/projects')}
          class="group relative overflow-hidden border border-gold-600 bg-gold-600 px-9 py-4.5 font-sans text-base font-medium text-ink-950 transition-colors duration-400"
        >
          <span class="relative z-10 flex items-center gap-3">
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M3 21h18" stroke-linecap="round" />
              <path d="M5 21V9.5l5-3.5v15" />
              <path d="M14 21V3l5 3.5V21" />
              <path d="M7.4 11.5v1.2M7.4 15v1.2M16.3 8.8V10M16.3 12.4v1.2M16.3 16v1.2" stroke-linecap="round" />
            </svg>
            צפו בפרויקטים
          </span>
          <span
            class="absolute inset-0 origin-right scale-x-0 bg-gold-300 transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:scale-x-100"
          ></span>
        </a>

        <a
          href="#contact"
          class="border border-ink-700 px-9 py-4.5 font-sans text-base text-steel-200 transition-colors duration-400 hover:border-gold-700 hover:text-gold-300"
        >
          יצירת קשר
        </a>
      </div>
    </div>

    <!-- Figures, set like a drawing schedule -->
    <dl
      class="mt-16 grid max-w-2xl grid-cols-3 border-t border-ink-800 pt-8 lg:mt-24"
      data-reveal
    >
      {
        stats.map((s) => (
          <div class="border-s border-ink-800 px-4 first:border-s-0 first:ps-0">
            <dd class="font-mono text-3xl text-gold-400 lg:text-5xl">
              <span class="nums" data-count={s.value}>0</span>
              <span class="text-gold-700">{s.suffix}</span>
              {s.unit && <span class="ms-1.5 font-sans text-sm text-steel-500">{s.unit}</span>}
            </dd>
            <dt class="mt-2.5 font-sans text-sm tracking-wide text-steel-400 lg:text-base">
              {s.label}
            </dt>
          </div>
        ))
      }
    </dl>
  </div>

  <!-- Scroll cue -->
  <a
    href="#about"
    class="group absolute bottom-9 start-1/2 hidden -translate-x-1/2 flex-col items-center gap-3 lg:flex"
    aria-label="גלול למטה"
    data-reveal
  >
    <span
      class="annot-he text-gold-500 transition-colors duration-300 group-hover:text-gold-300"
    >
      גלול
    </span>

    <span class="relative block h-16 w-px overflow-hidden bg-ink-600">
      <span class="absolute inset-x-0 top-0 h-5 animate-[cue_2.2s_ease-in-out_infinite] bg-gold-400"></span>
    </span>

    <svg
      class="size-4 animate-[nudge_2.2s_ease-in-out_infinite] text-gold-500 transition-colors duration-300 group-hover:text-gold-300"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6" />
    </svg>
  </a>
</section>

<style>
  @keyframes cue {
    0% { transform: translateY(-100%); }
    60%, 100% { transform: translateY(300%); }
  }

  @keyframes nudge {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.75; }
    30% { transform: translateY(4px); opacity: 1; }
  }
</style>
