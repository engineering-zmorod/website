---
// Hero drawing: the crane builds the tower, then the lens reviews it against
// a three-item checklist. Pure CSS; plays once each time the page loads.
---

<figure class="fig" data-crane aria-label="שרטוט של מגדל בבנייה, מנוף צריח שמניח אלמנט בראשו וזכוכית מגדלת שבודקת את השלד מול רשימת בקרה: תכן, מיגון ויציבות, יעילות">
    <div class="draw" aria-hidden="true">
      <!-- building -->
      <div class="tower slabs" style="left:122px; top:210px; width:164px; height:315px; border:1.5px solid var(--ink); border-bottom:0"></div>
      <div class="part-a slabs" style="left:122px; top:180px; width:102px; height:30px; border-left:1.5px solid var(--ink); border-top:1.5px solid var(--ink)"></div>
      <div class="part-b" style="left:122px; top:165px; width:62px; height:15px; border-left:1.5px solid var(--ink); border-top:1.5px solid var(--ink); background: repeating-linear-gradient(to right, transparent 0 40px, rgba(15,27,38,.22) 40px 41px), var(--fill)"></div>
      <div class="podium" style="left:98px; top:525px; width:212px; height:45px; border:1.5px solid var(--ink); border-bottom:0; background: repeating-linear-gradient(to bottom, transparent 0 14px, rgba(15,27,38,.55) 14px 15px), repeating-linear-gradient(to right, transparent 0 52px, rgba(15,27,38,.22) 52px 53px), var(--fill)"></div>
      <div class="core" style="left:184px; top:150px; width:40px; height:420px; border:1.5px solid var(--gold); border-bottom:0; background: color-mix(in srgb, var(--gold) 38%, transparent)"></div>
      <div class="stub k" style="left:122px; top:152px; width:1.5px; height:13px"></div>
      <div class="stub k" style="left:162px; top:152px; width:1.5px; height:13px"></div>
      <div class="stub k" style="left:244px; top:196px; width:1.5px; height:14px"></div>
      <div class="stub k" style="left:284px; top:196px; width:1.5px; height:14px"></div>

      <!-- crane mast and ties -->
      <div class="tie-b k" style="left:88px; top:270px; width:34px; height:2px"></div>
      <div class="tie-a k" style="left:88px; top:420px; width:34px; height:2px"></div>
      <div class="mast lattice" style="left:76px; top:66px; width:12px; height:504px; border-left:1.5px solid var(--ink); border-right:1.5px solid var(--ink)"></div>
      <div class="mast-base k" style="left:70px; top:572px; width:24px; height:6px"></div>

      <!-- crane head -->
      <div class="head group">
        <div class="k" style="left:81px; top:22px; width:3px; height:36px"></div>
        <div class="k" style="left:82px; top:22px; width:141px; height:1.5px; transform-origin:0 0; transform:rotate(11.5deg)"></div>
        <div class="k" style="left:82px; top:22px; width:55px; height:1.5px; transform-origin:0 0; transform:rotate(147deg)"></div>
        <div style="left:90px; top:50px; width:206px; height:8px; border-top:1.5px solid var(--ink); border-bottom:1.5px solid var(--ink); border-right:1.5px solid var(--ink); background: repeating-linear-gradient(60deg, transparent 0 5px, rgba(15,27,38,.75) 5px 6px), repeating-linear-gradient(-60deg, transparent 0 5px, rgba(15,27,38,.75) 5px 6px)"></div>
        <div style="left:30px; top:52px; width:46px; height:6px; border:1.5px solid var(--ink); background:var(--fill)"></div>
        <div class="k" style="left:30px; top:58px; width:18px; height:16px"></div>
        <div class="k" style="left:72px; top:58px; width:20px; height:8px"></div>
        <div style="left:90px; top:66px; width:14px; height:14px; border:1.5px solid var(--ink); background:var(--gold)"></div>
        <div class="k" style="left:251px; top:58px; width:10px; height:4px"></div>
      </div>

      <!-- hoist cable and the block it lowers -->
      <div class="cable k" style="left:255px; top:62px; width:1.5px; height:102px"></div>
      <div class="load group">
        <div class="k" style="left:253px; top:164px; width:6px; height:6px"></div>
        <div class="k" style="left:256px; top:170px; width:16px; height:1.5px; transform-origin:0 0; transform:rotate(29.7deg)"></div>
        <div class="k" style="left:256px; top:170px; width:16px; height:1.5px; transform-origin:0 0; transform:rotate(150.3deg)"></div>
        <div style="left:240px; top:178px; width:32px; height:14px; border:1.5px solid var(--ink); background:var(--gold)"></div>
      </div>

      <div class="ground k" style="left:20px; top:570px; width:300px; height:2px"></div>

      <!-- inspection lens: grows in, then scans up the structure -->
      <div class="lens-move">
        <div class="lens-grow">
          <div class="lens-handle"></div>
          <div class="lens-glass">
            <div class="lens-view">
              <div class="slabs" style="left:122px; top:210px; width:164px; height:315px; border:1.5px solid var(--ink); border-bottom:0"></div>
              <div style="left:184px; top:150px; width:40px; height:420px; border:1.5px solid var(--gold); border-bottom:0; background: color-mix(in srgb, var(--gold) 38%, transparent)"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- review checklist: ticked one by one as the lens climbs -->
      <div class="check-card">
        <div class="check-clip"></div>
        <div class="check-label" style="top:8px">תכן</div>
        <div class="check-box" style="top:11px"><div class="tick t1"><div></div></div></div>
        <div class="check-label" style="top:32px; height:28px; line-height:14px; white-space:normal">מיגון<br>ויציבות</div>
        <div class="check-box" style="top:39px"><div class="tick t2"><div></div></div></div>
        <div class="check-label" style="top:64px">יעילות</div>
        <div class="check-box" style="top:67px"><div class="tick t3"><div></div></div></div>
      </div>
    </div>
  </figure>

<script>
  const fig = document.querySelector<HTMLElement>('[data-crane]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Plays once, when the drawing scrolls into view
  if (fig && !reduce) {
    if ('IntersectionObserver' in window) {
      fig.classList.add('wait');
      const io = new IntersectionObserver((es) => {
        if (es.some((e) => e.isIntersecting)) { fig.classList.remove('wait'); fig.classList.add('play'); io.disconnect(); }
      }, { threshold: 0.35 });
      io.observe(fig);
    } else fig.classList.add('play');
  }
</script>

<style>
.fig {
  margin: 0; display: flex; justify-content: center; padding: 40px 0; overflow: hidden;
  border: 1px solid var(--line);
  background-color: var(--panel);
  background-image: linear-gradient(rgba(15,27,38,.06) 1px, transparent 1px), linear-gradient(90deg, rgba(15,27,38,.06) 1px, transparent 1px);
  background-size: 24px 24px;
}
.draw { position: relative; direction: ltr; flex: none; width: 340px; height: 584px; }
.draw div { position: absolute; }
.wait .draw { visibility: hidden; }
.group { left: 0; top: 0; width: 340px; height: 584px; }
.k { background: var(--ink); }
.slabs { background:
  repeating-linear-gradient(to bottom, transparent 0 14px, rgba(15,27,38,.55) 14px 15px),
  repeating-linear-gradient(to right, transparent 0 40px, rgba(15,27,38,.22) 40px 41px),
  var(--fill); }
.lattice { background:
  repeating-linear-gradient(45deg, transparent 0 5px, rgba(15,27,38,.75) 5px 6px),
  repeating-linear-gradient(-45deg, transparent 0 5px, rgba(15,27,38,.75) 5px 6px),
  var(--fill); }

/* Inspection lens: a real 2x view of the structure beneath it. */
.lens-move { left: 175px; top: 270px; width: 120px; height: 120px; }
.lens-grow { left: 0; top: 0; width: 120px; height: 120px; transform-origin: 60px 60px; }
.lens-handle { left: 100px; top: 97px; width: 46px; height: 9px; background: var(--ink); transform-origin: 0 50%; transform: rotate(45deg); }
.lens-glass { left: 0; top: 0; width: 120px; height: 120px; border: 3px solid var(--ink); border-radius: 50%; overflow: hidden; background: var(--fill); }
.lens-glass::after { content: ''; position: absolute; inset: 0; border-radius: 50%; box-shadow: inset 0 0 0 2px var(--gold); }
.lens-view { left: 0; top: 0; width: 340px; height: 584px; transform-origin: 0 0; transform: translate(-413px, -603px) scale(2); }

/* Review checklist: one item is ticked at each stop of the lens. */
.check-card { left: 0; top: 326px; width: 70px; height: 96px; border: 1.5px solid var(--ink); background: var(--fill); }
.check-clip { left: 22px; top: -6px; width: 23px; height: 8px; background: var(--ink); }
.check-label { left: 3px; width: 41px; height: 20px; line-height: 20px; direction: rtl; text-align: right; white-space: nowrap; font-family: var(--font-body); font-size: 11.5px; font-weight: 500; color: var(--ink); }
.check-box { left: 48px; width: 14px; height: 14px; border: 1.5px solid var(--ink); background: var(--panel); }
.tick { left: -1.5px; top: -1.5px; width: 14px; height: 14px; border: 1.5px solid var(--ink); background: var(--gold); }
.tick div { left: 3px; top: .5px; width: 5px; height: 8px; border-right: 2px solid var(--ink); border-bottom: 2px solid var(--ink); transform: rotate(45deg); }

/* The build sequence. Without .play the drawing rests in its finished state. */
.cable { transform-origin: 50% 0; }
.ground { transform-origin: 50% 50%; }
.play .ground    { animation: growX .4s ease-out 0s both; }
.play .mast      { animation: rise .8s ease-out .3s both; }
.play .mast-base { animation: fade .2s linear .3s both; }
.play .head      { animation: fade .4s ease-out 1s both; }
.play .podium    { animation: rise .3s steps(3, end) 1.3s both; }
.play .core      { animation: rise 1.9s linear 1.4s both; }
.play .tower     { animation: rise 1.6s steps(21, end) 1.6s both; }
.play .tie-a     { animation: fade .15s linear 2.15s both; }
.play .tie-b     { animation: fade .15s linear 2.9s both; }
.play .part-a    { animation: rise .25s steps(2, end) 3.2s both; }
.play .part-b    { animation: fade .15s linear 3.45s both; }
.play .stub      { animation: fade .2s linear 3.55s both; }
.play .cable     { animation: fade .4s ease-out 1s both, pay 1.3s cubic-bezier(.3,.1,.2,1) 3.7s both; }
.play .load      { animation: fade .4s ease-out 1s both, lower 1.3s cubic-bezier(.3,.1,.2,1) 3.7s both; }
.play .check-card { animation: fade .4s ease-out 5.1s both; }
.play .lens-grow  { animation: lensIn .7s cubic-bezier(.2,1.4,.4,1) 5.1s both; }
.play .lens-move  { animation: lensMove 1.8s ease-in-out 6.2s both; }
.play .lens-view  { animation: lensView 1.8s ease-in-out 6.2s both; }
.play .t1 { animation: pop .3s cubic-bezier(.2,1.6,.4,1) 5.9s both; }
.play .t2 { animation: pop .3s cubic-bezier(.2,1.6,.4,1) 7s both; }
.play .t3 { animation: pop .3s cubic-bezier(.2,1.6,.4,1) 8.1s both; }
@keyframes lensIn   { from { opacity: 0; transform: scale(.1); } to { opacity: 1; transform: scale(1); } }
@keyframes lensMove { 0% { transform: translateY(140px); } 39%, 61% { transform: translateY(70px); } 100% { transform: translateY(0); } }
@keyframes lensView { 0% { transform: translate(-413px, -883px) scale(2); } 39%, 61% { transform: translate(-413px, -743px) scale(2); } 100% { transform: translate(-413px, -603px) scale(2); } }
@keyframes pop      { from { opacity: 0; transform: scale(.2); } to { opacity: 1; transform: scale(1); } }
@keyframes fade  { from { opacity: 0; } to { opacity: 1; } }
@keyframes growX { from { transform: scaleX(0); } to { transform: scaleX(1); } }
@keyframes rise  { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0 0 0 0); } }
@keyframes pay   { from { transform: scaleY(.12); } to { transform: scaleY(1); } }
@keyframes lower { from { transform: translateY(-89.8px); } to { transform: translateY(0); } }
</style>
