---
// UNUSED — kept for reference. Static 2x2 card grid version of the services
// section. Swap it in for Services.astro to use it.
import { Image } from 'astro:assets';
import towers from '../../assets/hero-tower.avif';
import design from '../../assets/service-design.avif';
import review from '../../assets/service-review.avif';
import supervision from '../../assets/service-supervision.avif';
import { services } from '../lib/site';

// Order matches `services` — towers first.
const media = [towers, design, review, supervision];
---

<section id="services" class="relative overflow-hidden bg-ink-950 py-24 lg:py-32">
  <div class="absolute inset-0 bg-blueprint opacity-30"></div>

  <div class="pointer-events-none absolute inset-0 bg-grain opacity-[0.12] mix-blend-overlay"></div>

  <div class="relative mx-auto max-w-[100rem] px-6 lg:pe-12 lg:ps-[clamp(4.5rem,6vw,9rem)]">
    <h2
      class="font-display text-[clamp(2.6rem,5vw,4.5rem)] leading-[1.02] font-light text-steel-100"
      data-srv-in
    >
      שירותי <span class="text-gold-gradient">החברה</span>
    </h2>

    <div class="mt-16 grid gap-x-10 gap-y-14 md:grid-cols-2">
      {
        services.map((s, i) => (
          <article class="group relative min-h-[32rem] overflow-hidden border border-ink-800 transition-colors duration-500 hover:border-gold-600 lg:min-h-[36rem]" data-srv-card>
            <Image
              src={media[i]}
              alt=""
              widths={[480, 900, 1400]}
              sizes="(max-width: 768px) 92vw, 46vw"
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-[900ms] ease-[var(--ease-out-expo)] group-hover:scale-[1.06]"
            />

            {/* Legibility: flat wash for the whole frame, then a heavy foot so
                the copy always has something solid under it. */}
            <div class="pointer-events-none absolute inset-0 bg-ink-950/45" />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink-950 via-ink-950/80 via-45% to-transparent" />

            <span class="annot nums absolute top-5 end-6 text-gold-400 drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)]">
              {String(i + 1).padStart(2, '0')}
            </span>

            <div class="absolute inset-x-0 bottom-0 p-7 lg:p-9 [text-shadow:0_2px_12px_rgb(0_0_0_/_0.85)]">
              <h3 class="font-display text-2xl text-steel-100 lg:text-3xl">{s.name}</h3>
              <p class="mt-3 font-sans text-base leading-relaxed text-steel-200">{s.lead}</p>

              <ul class="mt-5 space-y-2.5 border-t border-steel-100/15 pt-5">
                {s.items.map((it) => (
                  <li class="flex gap-3 font-sans text-base leading-relaxed text-steel-300">
                    <span class="mt-2.5 block size-1 shrink-0 bg-gold-500" />
                    {it}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
